# Copiar como .env.local en desarrollo. En el servidor van como variables de
# entorno del contenedor. Ninguna lleva NEXT_PUBLIC_: nada de esto llega al
# navegador.

# URL interna de la API .NET. En Docker: http://api:8080
API_URL=http://127.0.0.1:5080

# URL pública del sitio, sin barra al final. Se usa para links absolutos
# (mails, login con Google, vista previa al compartir). En producción:
# SITE_URL=https://ruedaro.com.ar
SITE_URL=http://localhost:3000
